# systemd 部署时复制到 /etc/browser-relay.env；本地跑则 export 到 shell 里
BROWSER_RELAY_HOST=127.0.0.1
BROWSER_RELAY_PORT=8271
BROWSER_RELAY_CDP_PORT=9333
BROWSER_RELAY_PROFILE=/opt/ai-social-browser/relay/profile

# 手机登录密码。必须设强密码：登录没有防爆破，这就是唯一的一道门。
# 留空 = 无门禁，仅限本机调试。
BROWSER_RELAY_PASS=

# 可选：指定 Chrome 可执行文件路径；不设则自动探测
#CHROME_BIN=/usr/bin/google-chrome-stable
