# /etc/systemd/system/browser-relay.service
# 路径按你的实际安装位置改（这里假设装在 /opt/browser-relay，venv 在其下）
[Unit]
Description=Browser Relay headed Chrome over CDP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/browser-relay
EnvironmentFile=/etc/browser-relay.env
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x960x24" /opt/browser-relay/venv/bin/python /opt/browser-relay/relay.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
